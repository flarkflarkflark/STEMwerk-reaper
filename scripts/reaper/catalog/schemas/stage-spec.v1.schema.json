{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stemwerk.invalid/schemas/stage-spec.v1.schema.json",
  "title": "StageSpec v1",
  "type": "object",
  "required": ["schema_version", "stage_id", "order", "capability_id", "model_id", "input", "outputs"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "stage_id": {"type": "string"},
    "order": {"type": "integer", "minimum": 1},
    "capability_id": {"type": "string"},
    "model_id": {"type": "string"},
    "input": {
      "oneOf": [
        {"type": "object", "required": ["kind", "source_id", "artifact_kind"], "properties": {"kind": {"const": "source"}, "source_id": {"type": "string"}, "artifact_kind": {"const": "audio"}}, "additionalProperties": false},
        {"type": "object", "required": ["kind", "stage_id", "port_id", "artifact_kind"], "properties": {"kind": {"const": "stage_output"}, "stage_id": {"type": "string"}, "port_id": {"type": "string"}, "artifact_kind": {"const": "audio"}}, "additionalProperties": false}
      ]
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["port_id", "semantic_id", "kind"],
        "properties": {"port_id": {"type": "string"}, "semantic_id": {"type": "string"}, "kind": {"const": "audio"}},
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
