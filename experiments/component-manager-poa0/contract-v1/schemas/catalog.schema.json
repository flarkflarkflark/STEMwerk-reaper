{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stemwerk.example/contracts/component-manager/v1/catalog.schema.json",
  "title": "Component Manager catalog",
  "type": "object",
  "required": [
    "schema_version",
    "catalog_version",
    "trust_status",
    "components",
    "flows"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "catalog_version": {
      "type": "string",
      "minLength": 1
    },
    "trust_status": {
      "enum": [
        "trusted",
        "untrusted",
        "unknown",
        "revoked"
      ]
    },
    "components": {
      "type": "array"
    },
    "flows": {
      "type": "array"
    }
  }
}
