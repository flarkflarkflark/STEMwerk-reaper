# This file has always been consistently CRLF itself; declare it explicitly
# (see the fetch_runtime_assets.ps1 rule below for why).
.gitattributes text eol=crlf

# Ensure bash scripts run on Linux/macOS runners
installer/**/*.sh text eol=lf
installer/linux/stemwerk-integrate-reaper text eol=lf
installer/linux/arch/*.install text eol=lf
.github/workflows/*.yml text eol=lf

# This file has always been consistently CRLF; declare it explicitly so
# git diff --check doesn't flag its native \r as trailing whitespace. Not
# applied repo-wide to *.ps1 since other PowerShell files here have mixed
# CRLF/LF endings and forcing eol=crlf on those would cause line-ending
# churn on next checkout.
installer/windows/fetch_runtime_assets.ps1 text eol=crlf

# Predominantly CRLF already; same rationale as fetch_runtime_assets.ps1 above.
installer/README.md text eol=crlf

# The managed-runtime manifest is read byte-exactly by Core, Inno Setup and sh;
# it must keep LF line endings on every checkout (design G4).
scripts/reaper/vendor/stemwerk-core/src/stemwerk_core/runtime-manifest.v1.tsv text eol=lf

# The FFmpeg pin file is Core-only JSON; Core refuses it when a CRLF checkout changed it.
scripts/reaper/vendor/stemwerk-core/src/stemwerk_core/ffmpeg-pin.v1.json text eol=lf
