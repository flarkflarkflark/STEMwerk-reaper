{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stemwerk.example/contracts/component-manager/v1/signature-envelope.schema.json",
  "title": "Versioned signature envelope",
  "type": "object",
  "required": [
    "schema_version",
    "envelope_version",
    "key_fingerprint",
    "algorithm",
    "payload_digest",
    "canonicalization",
    "signature",
    "trust_scope",
    "signer"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "envelope_version": {
      "const": 1
    },
    "key_fingerprint": {
      "type": "string",
      "pattern": "^(ed25519|ecdsa-p256):[a-f0-9]{64}$"
    },
    "algorithm": {
      "enum": [
        "Ed25519",
        "ECDSA-P256-SHA256"
      ]
    },
    "payload_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "canonicalization": {
      "const": "RFC8785-JCS"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "trust_scope": {
      "enum": [
        "official.catalog",
        "official.artifact",
        "official.helper",
        "user.catalog",
        "development.local"
      ]
    },
    "signer": {
      "type": "string",
      "minLength": 1
    },
    "signed_at": {
      "type": "string"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
