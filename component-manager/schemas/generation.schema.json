{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stemwerk.example/contracts/component-manager/v1/generation.schema.json",
  "title": "Component Manager generation",
  "type": "object",
  "required": [
    "schema_version",
    "generation_id",
    "manifest_digest",
    "components",
    "compatibility_result",
    "created_by"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "generation_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "components": {
      "type": "array"
    },
    "compatibility_result": {
      "enum": [
        "compatible",
        "incompatible",
        "unknown"
      ]
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    }
  }
}
